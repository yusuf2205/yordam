# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (matches docker-compose.yml at the repo root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=yordam
DB_PASSWORD=yordam
DB_NAME=yordam

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# AI orchestration (see src/ai). Without this set, /api/ai/chat responds
# with an explanatory message instead of calling the model.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
